{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },

    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },

    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "required": true
    },

    "excerpt": {
      "type": "text",
      "required": true
    },

    "content": {
      "type": "richtext"
    },

    "category": {
      "type": "enumeration",
      "enum": [
        "Buyer",
        "Seller",
        "Market Updates",
        "Neighborhood Guide",
        "Financing",
        "Investment",
        "Home Maintenance",
        "General"
      ],
      "default": "General",
      "required": true
    },

    "tags": {
      "type": "json"
    },

    "featured": {
      "type": "boolean",
      "default": false
    },

    "readTime": {
      "type": "integer",
      "default": 5
    },

    "publishedDate": {
      "type": "datetime"
    },

    "seoTitle": {
      "type": "string"
    },

    "seoDescription": {
      "type": "text"
    },

    "canonicalUrl": {
      "type": "string"
    }
  }
}